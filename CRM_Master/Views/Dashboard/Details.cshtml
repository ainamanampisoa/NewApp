@model List<CRM_Master.Models.DepenseTicketDTO>

@{
    ViewData["Title"] = "Détails des Tickets";
}

<div class="container mt-5">
    <h2 class="text-center mb-4">Détails des Tickets</h2>

    <!-- Affichage du message de succès -->
    @if (ViewBag.SuccessMessage != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @ViewBag.SuccessMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Affichage du message d'erreur -->
    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @ViewBag.ErrorMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (Model != null && Model.Any())
    {
        <div class="table-responsive shadow-lg p-3 mb-5 bg-body rounded">
            <table class="table table-bordered text-center">
                <thead class="table-light">
                    <tr>
                        <th scope="col">Ticket</th>
                        <th scope="col">Montant</th>
                        <th scope="col">Date de Création</th>
                        <th scope="col">Client</th>
                        <th scope="col">Statut</th>
                        <th scope="col">Sujet</th>
                        <th scope="col">Description</th>
                        <th scope="col">Priorité</th>
                        <th scope="col">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var ticket in Model)
                    {
                        <tr>
                            <td><strong>@ticket.Ticket.Ticket</strong></td>
                            <td>@ticket.Amount €</td>
                            <td>@ticket.CreatedAt.ToString("dd-MM-yyyy HH:mm")</td>
                            <td>@ticket.Ticket.Customer?.Name</td>
                            <td>@ticket.Ticket.Status</td>
                            <td>@ticket.Ticket.Subject</td>
                            <td class="text-truncate" style="max-width: 200px;">@ticket.Ticket.Description</td>
                            <td>@ticket.Ticket.Priority</td>
                            <td>
                                @if (ticket.Ticket.DeleteAt != null)
                                {
                                    <span class="text-muted">Supprimé le : @ticket.Ticket.DeleteAt.Value.ToString("dd-MM-yyyy HH:mm")</span>
                                }
                                else
                                {
                                    <div class="btn-group" role="group">
                                        <!-- Bouton Modifier avec couleur gris -->
                                        <a href="@Url.Action("Update", new { id = ticket.Ticket.Ticket })" class="btn btn-outline-secondary btn-sm me-2">
                                            Modifier
                                        </a>
                                        <!-- Bouton Supprimer avec couleur rouge -->
                                        <form action="@Url.Action("Delete", new { id = ticket.Ticket.Ticket })" method="post" style="display:inline;">
                                            <button type="submit" class="btn btn-outline-danger btn-sm" onclick="return confirm('Êtes-vous sûr de vouloir supprimer ce ticket ?');">
                                                Supprimer
                                            </button>
                                        </form>
                                    </div>
                                }
                            </td>

                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-info text-center">Aucun ticket trouvé pour la période sélectionnée.</div>
    }
</div>