@model CRM_Master.Models.UpdateLead

@{
    ViewData["Title"] = "Mise à jour du montant";
}

<div class="container mt-5">
    <h2 class="text-center mb-4">Mise à jour du montant</h2>

    @if (!string.IsNullOrEmpty(Model.Message))
    {
        <div class="alert alert-warning">@Model.Message</div>
    }

    @if (Model.DepenseLead != null)
    {
        <div class="card shadow p-4">
            <h4 class="mb-3">Montant actuel : <strong>@Model.DepenseLead.Amount €</strong></h4>
            <h5 class="mb-4">depenseId : <strong>@Model.DepenseLead.DepenseId</strong></h5>

            <form asp-action="Updatelead" asp-controller="Lead" method="post">
                <input type="hidden" name="depenseId" value="@Model.DepenseLead.DepenseId" />

                <div class="mb-3">
                    <label for="newAmount" class="form-label">Nouveau montant</label>
                    <input type="number" step="0.01" class="form-control" id="newAmount" name="newAmount" 
                           value="@Model.DepenseLead.Amount" required>
                </div>

                <button type="submit" class="btn btn-primary w-100">Mettre à jour</button>
            </form>
        </div>
    }
    else
    {
        <p class="text-danger text-center mt-3">Aucune dépense trouvée.</p>
    }
</div>

<!-- Ajouter le lien Bootstrap pour les scripts JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
