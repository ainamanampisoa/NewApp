@model CRM_Master.Models.request.AuthRequest

@{
    Layout = null;
    ViewBag.Title = "Login";
}


<!-- Ajout de Bootstrap -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

<div class="d-flex justify-content-center align-items-center vh-100 bg-light">
    <div class="card shadow p-4 rounded" style="width: 350px;">
        <h2 class="text-center text-primary mb-3">New App Login</h2>
        
        <form asp-action="Login" method="post">
            <div class="mb-3">
                <label asp-for="Username" class="form-label fw-semibold">Login</label>
                <input asp-for="Username" type="text" class="form-control" placeholder="Entrez votre login">
                <span asp-validation-for="Username" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label fw-semibold">Mot de passe</label>
                <input asp-for="Password" type="password" class="form-control" placeholder="Entrez votre mot de passe">
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary w-100">Se connecter</button>
        </form>
    </div>
</div>

